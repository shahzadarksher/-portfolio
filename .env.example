# GitHub Configuration
# Get your GitHub Personal Access Token from: https://github.com/settings/tokens
# Required scopes: public_repo, read:user
REACT_APP_GITHUB_TOKEN=your_github_personal_access_token_here
REACT_APP_GITHUB_USERNAME=your_github_username_here

# These are also used by git_data_fetcher.mjs
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username_here
